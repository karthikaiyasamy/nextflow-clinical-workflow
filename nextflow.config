/*
 * Nextflow Configuration for Clinical Telemetry ETL Pipeline
 */

params {
    telemetry = "$projectDir/data/telemetry/*.csv"
    registry  = "$projectDir/data/db/resident_registry.csv"
    outdir    = "$projectDir/results"
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
        process.cpus = 1
        process.memory = '2 GB'
    }

    hpc_cluster {
        process.executor = 'slurm'
        process.queue = 'production'
        process.cpus = 2
        process.memory = '4 GB'
        process.errorStrategy = 'retry'
        process.maxRetries = 2
    }
}

// Generate execution timeline, trace, and dag reports
timeline {
    enabled = true
    file    = "${params.outdir}/execution_reports/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/execution_reports/report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/execution_reports/trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/execution_reports/pipeline_dag.html"
}

